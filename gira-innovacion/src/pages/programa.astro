---
import Layout from '../layouts/Layout.astro';
import { programa } from '../data/programa';
---

<Layout>
	<main>
		<header class="page-header">
			<a href="/" class="back">← Volver</a>

			<div class="header-content">
				<p class="eyebrow">Gira de innovación AgrocoopInnova 2026</p>
				<h1>Programa</h1>
				<p>
					Una experiencia para conocer, aprender y compartir
					innovación, cooperativismo y agricultura campesina.
				</p>
			</div>
		</header>

		<section class="program">
			<div class="section-intro">
				<p class="section-label">LA GIRA</p>
				<h2>Un recorrido para aprender haciendo</h2>
				<p>
					Cada jornada combina visitas, conversaciones y experiencias
					con organizaciones que han desarrollado soluciones
					aplicables a la realidad de las cooperativas.
				</p>

				<a
					class="download-button"
					href="/programa-gira-innovacion-2026.pdf"
					download
				>
					<span>↓</span>
					Descargar programa completo
				</a>
			</div>

			{
				programa.map((dia) => (
					<article
						class:list={['day', { 'arrival-day': dia.id === '06' }]}
						data-day={dia.id}
					>
						<div class:list={['date', { 'arrival-date': dia.id === '06' }]}>
							<span class="day-number">{dia.id}</span>
							<span class="month">SEP</span>
						</div>

						<div class="day-content">
							<p class="day-label">{dia.fechaTexto}</p>

							{dia.jornadas.map((jornada, indice) => (
								<>
									{indice > 0 && jornada.visitaId && <div class="visit-divider"></div>}
									<div class:list={['session', { 'return-session': jornada.id === '2026-09-11-tarde' }]}>
										<p class="session-label">{jornada.etiqueta}</p>
										<h2>{jornada.titulo}</h2>
										<p class="location">📍 {jornada.lugar}</p>

										{jornada.actividades.map((actividad) => (
											<div class="activity">
												<strong>{actividad.titulo}</strong>
												<p>{actividad.descripcion}</p>
											</div>
										))}
									</div>
								</>
							))}
						</div>
					</article>
				))
			}
		</section>

		<section class="closing">
			<p class="closing-label">UNA GIRA PARA COMPARTIR</p>
			<h2>
				Conocer experiencias. Encontrar ideas. Generar vínculos.
			</h2>
			<a href="/" class="home-button">Volver al inicio</a>
		</section>

		<footer>
			<p>Gira de innovación AgrocoopInnova 2026</p>
			<p><a class="footer-link" href="https://lonquensur.cl" target="_blank" rel="noopener noreferrer">LonquenSur</a> - IEAC</p>
			<p>Sitio construido con ASTRO</p>
		</footer>
	</main>
</Layout>

<script>
	const diaSeleccionado = new URLSearchParams(window.location.search).get('dia');

	if (diaSeleccionado) {
		document.querySelectorAll<HTMLElement>('[data-day]').forEach((jornada) => {
			jornada.hidden = jornada.dataset.day !== diaSeleccionado;
		});

		const introduccion = document.querySelector<HTMLElement>('.section-intro');
		const cierre = document.querySelector<HTMLElement>('.closing');
		if (introduccion) introduccion.hidden = true;
		if (cierre) cierre.hidden = true;
	}
</script>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family: Arial, Helvetica, sans-serif;
		background: #f5f3ed;
		color: #24352a;
	}

	.day[hidden],
	.section-intro[hidden],
	.closing[hidden] {
		display: none;
	}

	main {
		min-height: 100vh;
	}

	.page-header {
		background: #294936;
		color: white;
		padding: 18px 20px 34px;
	}

	.back {
		display: inline-block;
		margin-bottom: 24px;
		color: #e5ebe6;
		text-decoration: none;
		font-size: 14px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 2px;
		opacity: 0.9;
	}

	.brand-line {
		width: 24px;
		height: 2px;
		background: #d9b85c;
	}

	.brand a {
		color: inherit;
		text-decoration: none;
	}

	.header-content {
		max-width: 620px;
		margin: 42px auto 0;
	}

	.eyebrow {
		margin: 0 0 10px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 1.5px;
		color: #e4c96e;
	}

	.header-content h1 {
		margin: 0;
		font-size: clamp(40px, 11vw, 62px);
		line-height: 1;
		letter-spacing: -1.5px;
	}

	.header-content p:last-child {
		max-width: 470px;
		margin: 20px 0 0;
		font-size: 17px;
		line-height: 1.5;
		color: #e5ebe6;
	}

	.program {
		max-width: 680px;
		margin: 0 auto;
		padding: 28px 16px 10px;
	}

	.section-intro {
		padding: 8px 4px 24px;
	}

	.section-label,
	.day-label,
	.closing-label {
		margin: 0 0 8px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1.5px;
		color: #8b7950;
	}

	.section-intro h2 {
		margin: 0;
		font-size: 27px;
		line-height: 1.15;
	}

	.section-intro > p:last-child {
		margin: 12px 0 0;
		font-size: 15px;
		line-height: 1.55;
		color: #68736b;
	}

	.day {
		display: grid;
		grid-template-columns: 66px 1fr;
		gap: 18px;
		margin-bottom: 16px;
		padding: 20px 18px;
		background: white;
		border-radius: 16px;
		box-shadow: 0 2px 9px rgba(30, 50, 35, 0.08);
	}

	.arrival-day {
		background: #f8f5e9;
		border: 1px solid #e7ddbc;
	}

	.date {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		width: 60px;
		height: 68px;
		padding-top: 8px;
		border-radius: 12px;
		background: #edf2eb;
	}

	.arrival-date {
		background: #e7ddbc;
	}

	.day-number {
		font-size: 27px;
		font-weight: 700;
		line-height: 1;
		color: #294936;
	}

	.month {
		margin-top: 5px;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 1px;
		color: #718078;
	}

	.day-content h2 {
		margin: 0;
		font-size: 22px;
		line-height: 1.2;
		color: #24352a;
	}

	.session-label {
		display: inline-block;
		margin: 0 0 9px;
		padding: 5px 9px;
		border-radius: 6px;
		background: #edf2eb;
		color: #294936;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.8px;
		text-transform: uppercase;
	}

	.arrival-day .session-label {
		background: #e7ddbc;
		color: #5b5133;
	}

	.location {
		margin: 6px 0 17px;
		font-size: 14px;
		color: #68736b;
	}

	.activity {
		margin-top: 14px;
	}

	.activity strong {
		display: block;
		font-size: 15px;
		color: #294936;
	}

	.activity p {
		margin: 5px 0 0;
		font-size: 14px;
		line-height: 1.5;
		color: #5f6962;
	}

	.visit-divider {
		height: 1px;
		margin: 24px 0;
		background: #e5e8e4;
	}

	.return-session {
		padding-top: 2px;
	}

	.return-session h2 {
		font-size: 21px;
	}

	.download-button {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		margin-top: 18px;
		padding: 13px 20px;
		border-radius: 10px;
		background: #294936;
		color: white;
		text-decoration: none;
		font-weight: 700;
		transition: transform 0.2s ease, opacity 0.2s ease;
	}

	.download-button span {
		font-size: 18px;
		line-height: 1;
	}

	.download-button:hover {
		transform: translateY(-2px);
		opacity: 0.9;
	}

	.closing {
		max-width: 680px;
		margin: 10px auto 0;
		padding: 32px 20px;
		background: #e7ddbc;
		text-align: center;
	}

	.closing-label {
		color: #5b5133;
	}

	.closing h2 {
		max-width: 480px;
		margin: 0 auto 20px;
		font-size: 24px;
		line-height: 1.25;
	}

	.home-button {
		display: inline-block;
		padding: 13px 20px;
		border-radius: 10px;
		background: #294936;
		color: white;
		text-decoration: none;
		font-weight: 700;
	}

	footer {
		max-width: 680px;
		margin: 0 auto;
		padding: 28px 20px 36px;
		text-align: center;
		font-size: 12px;
		line-height: 1.5;
		color: #788078;
	}

	footer p {
		margin: 3px 0;
	}

	@media (min-width: 700px) {
		.page-header {
			padding: 22px 32px 44px;
		}

		.program {
			padding-top: 36px;
		}

		.day {
			padding: 24px;
		}
	}
</style>
