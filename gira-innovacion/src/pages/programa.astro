---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main>
		<header class="page-header">
			<a href="/" class="back">← Volver</a>

			<div class="brand">
				<span class="brand-line"></span>
				<span>LONQUENSUR</span>
			</div>

			<div class="header-content">
				<p class="eyebrow">AGROCOOPINNOVA 2026</p>
				<h1>Programa</h1>
				<p>
					Una experiencia para conocer, aprender y compartir
					innovación, cooperativismo y agricultura campesina.
				</p>
			</div>
		</header>

		<section class="program">
			<div class="section-intro">
				<p class="section-label">LA GIRA</p>
				<h2>Un recorrido para aprender haciendo</h2>
				<p>
					Cada jornada combina visitas, conversaciones y experiencias
					con organizaciones que han desarrollado soluciones
					aplicables a la realidad de las cooperativas.
				</p>
			</div>

			<!-- DOMINGO 6 DE SEPTIEMBRE DE 2026 -->

			<article class="day arrival-day">
				<div class="date arrival-date">
					<span class="day-number">06</span>
					<span class="month">SEP</span>
				</div>

				<div class="day-content">
					<p class="day-label">DOMINGO 6 DE SEPTIEMBRE DE 2026</p>

					<div class="session">
						<p class="session-label">Llegada de participantes</p>

						<h2>Inicio de la experiencia</h2>
						<p class="location">
							📍 Comuna de Santiago · Región Metropolitana
						</p>

						<div class="activity">
							<strong>Recepción y encuentro</strong>
							<p>
								Llegada de los representantes de las 15 cooperativas
								participantes a Santiago y recepción en el punto
								de encuentro definido para el inicio de la gira.
							</p>
						</div>

						<div class="activity">
							<strong>Alojamiento y coordinación</strong>
							<p>
								Traslado al lugar de alojamiento y coordinación
								general de los participantes para el inicio de las
								actividades del día siguiente.
							</p>
						</div>
					</div>
				</div>
			</article>

			<!-- LUNES 7 DE SEPTIEMBRE DE 2026 -->

			<article class="day">
				<div class="date">
					<span class="day-number">07</span>
					<span class="month">SEP</span>
				</div>

				<div class="day-content">
					<p class="day-label">LUNES 7 DE SEPTIEMBRE DE 2026</p>

					<div class="session">
						<p class="session-label">Jornada Mañana</p>

						<h2>Fundación Origen</h2>
						<p class="location">
							📍 Comuna de Pirque · Región Metropolitana
						</p>

						<div class="activity">
							<strong>Inicio de la gira</strong>
							<p>
								Presentación de las cooperativas participantes,
								introducción al concepto de innovación y dinámica
								participativa para compartir conocimientos,
								experiencias y expectativas.
							</p>
						</div>
					</div>

					<div class="visit-divider"></div>

					<div class="session">
						<p class="session-label">Jornada Tarde</p>

						<h2>Visita de campo</h2>
						<p class="location">
							📍 Fundación Origen · Comuna de Pirque
						</p>

						<div class="activity">
							<strong>Agroecología y agricultura sustentable</strong>
							<p>
								Recorrido por el Mercado Campesino Origen y el
								banco de semillas tradicionales, conociendo en
								terreno la mirada de la Fundación sobre
								agroecología, producción sustentable y
								conservación de semillas.
							</p>
						</div>
					</div>
				</div>
			</article>

			<!-- MARTES 8 DE SEPTIEMBRE DE 2026 -->

			<article class="day">
				<div class="date">
					<span class="day-number">08</span>
					<span class="month">SEP</span>
				</div>

				<div class="day-content">
					<p class="day-label">MARTES 8 DE SEPTIEMBRE DE 2026</p>

					<div class="session">
						<p class="session-label">Jornada Mañana</p>

						<h2>
							Centro Tecnológico para la Innovación Alimentaria
							(CETA)
						</h2>
						<p class="location">
							📍 Comuna de Pudahuel · Región Metropolitana
						</p>

						<div class="activity">
							<strong>Innovación alimentaria</strong>
							<p>
								Conocer el ecosistema de innovación alimentaria,
								la infraestructura y los procesos que permiten
								desarrollar nuevos productos, diversificar
								producciones y agregar valor.
							</p>
						</div>
					</div>

					<div class="visit-divider"></div>

					<div class="session">
						<p class="session-label">Jornada Tarde</p>

						<h2>Agrícola Cinco Valles</h2>
						<p class="location">
							📍 Comuna de Melipilla · Región Metropolitana
						</p>

						<div class="activity">
							<strong>Modelo de servicios compartidos</strong>
							<p>
								Conocer su organización, principales dificultades
								y modelo de servicios técnicos compartidos,
								incluyendo SAT INDAP y asesoría en riego.
							</p>
						</div>
					</div>
				</div>
			</article>

			<!-- MIÉRCOLES 9 DE SEPTIEMBRE DE 2026 -->

			<article class="day">
				<div class="date">
					<span class="day-number">09</span>
					<span class="month">SEP</span>
				</div>

				<div class="day-content">
					<p class="day-label">MIÉRCOLES 9 DE SEPTIEMBRE DE 2026</p>

					<div class="session">
						<p class="session-label">Jornada</p>

						<h2>COOPEUMO</h2>
						<p class="location">
							📍 Comuna de Peumo · Región de O'Higgins
						</p>

						<div class="activity">
							<strong>Modelo cooperativo campesino</strong>
							<p>
								Jornada de capacitación y conversación para conocer
								los principales logros, dificultades y desafíos
								actuales de la cooperativa.
							</p>
						</div>

						<div class="activity">
							<strong>Visita a instalaciones</strong>
							<p>
								Recorrido y conversatorio sobre su experiencia en
								servicios integrales para sus socios, incluyendo
								insumos, financiamiento, asistencia técnica y
								comercialización.
							</p>
						</div>
					</div>
				</div>
			</article>

			<!-- JUEVES 10 DE SEPTIEMBRE DE 2026 -->

			<article class="day">
				<div class="date">
					<span class="day-number">10</span>
					<span class="month">SEP</span>
				</div>

				<div class="day-content">
					<p class="day-label">JUEVES 10 DE SEPTIEMBRE DE 2026</p>

					<div class="session">
						<p class="session-label">Jornada Mañana</p>

						<h2>Cooperativa Campesina Tres Piedras</h2>
						<p class="location">
							📍 Comuna de Pelluhue · Región del Maule
						</p>

						<div class="activity">
							<strong>Innovación y alianzas</strong>
							<p>
								Conocer los desafíos de una cooperativa en proceso
								de desarrollo, las soluciones implementadas y el
								acceso a innovación tecnológica mediante alianzas
								estratégicas.
							</p>
						</div>

						<div class="activity">
							<strong>Visita a terreno</strong>
							<p>
								Visita a predios y packing para conocer directamente
								su experiencia productiva.
							</p>
						</div>
					</div>

					<div class="visit-divider"></div>

					<div class="session">
						<p class="session-label">Jornada Tarde</p>

						<h2>Cooperativa Vitivinícola Loncomilla</h2>
						<p class="location">
							📍 Comuna de San Javier · Región del Maule
						</p>

						<div class="activity">
							<strong>Experiencia cooperativa</strong>
							<p>
								Conocer la historia, problemas y logros de una
								cooperativa con más de seis décadas de trayectoria.
							</p>
						</div>

						<div class="activity">
							<strong>Innovación y mercados</strong>
							<p>
								Visita a planta y viñedos, junto con la presentación
								del proyecto Invicto y el proceso de certificación
								Fairtrade.
							</p>
						</div>
					</div>
				</div>
			</article>

			<!-- VIERNES 11 DE SEPTIEMBRE DE 2026 -->

			<article class="day">
				<div class="date">
					<span class="day-number">11</span>
					<span class="month">SEP</span>
				</div>

				<div class="day-content">
					<p class="day-label">VIERNES 11 DE SEPTIEMBRE DE 2026</p>

					<div class="session">
						<p class="session-label">Jornada Mañana</p>

						<h2>
							Cooperativa Campesina Mujeres de Pelarco (COOPCAM)
						</h2>
						<p class="location">
							📍 Comuna de Pelarco · Región del Maule
						</p>

						<div class="activity">
							<strong>Cooperativismo y emprendimiento femenino</strong>
							<p>
								Conversación con las integrantes de la Cooperativa
								Campesina Mujeres de Pelarco para conocer sus
								aciertos, dificultades y aprendizajes durante sus
								años de funcionamiento.
							</p>
						</div>

						<div class="activity">
							<strong>Visita a instalaciones</strong>
							<p>
								Conocer la experiencia productiva de la cooperativa,
								sus instalaciones y sala de venta.
							</p>
						</div>
					</div>

					<div class="visit-divider"></div>

					<div class="session return-session">
						<p class="session-label">Jornada Tarde</p>

						<h2>Vuelta de los participantes a sus hogares</h2>
						<p class="location">
							📍 Desde Pelarco · Región del Maule
						</p>

						<div class="activity">
							<strong>Retorno</strong>
							<p>
								Finalizadas las actividades de la gira, se realizará
								la coordinación y retorno de los participantes a
								sus respectivos lugares de origen.
							</p>
						</div>
					</div>
				</div>
			</article>
		</section>

		<section class="closing">
			<p class="closing-label">UNA GIRA PARA COMPARTIR</p>
			<h2>
				Conocer experiencias. Encontrar ideas. Generar vínculos.
			</h2>
			<a href="/" class="home-button">Volver al inicio</a>
		</section>

		<footer>
			<p>Gira Tecnológica de Innovación 2026</p>
			<p>AgroCoopInnova · Lonquensur</p>
		</footer>
	</main>
</Layout>

<style>
	:global(*) {
		box-sizing: border-box;
	}

	:global(body) {
		margin: 0;
		font-family: Arial, Helvetica, sans-serif;
		background: #f5f3ed;
		color: #24352a;
	}

	main {
		min-height: 100vh;
	}

	.page-header {
		background: #294936;
		color: white;
		padding: 20px 20px 42px;
	}

	.back {
		display: inline-block;
		margin-bottom: 24px;
		color: #e5ebe6;
		text-decoration: none;
		font-size: 14px;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 2px;
		opacity: 0.9;
	}

	.brand-line {
		width: 24px;
		height: 2px;
		background: #d9b85c;
	}

	.header-content {
		max-width: 620px;
		margin: 42px auto 0;
	}

	.eyebrow {
		margin: 0 0 10px;
		font-size: 13px;
		font-weight: 700;
		letter-spacing: 1.5px;
		color: #e4c96e;
	}

	.header-content h1 {
		margin: 0;
		font-size: clamp(40px, 11vw, 62px);
		line-height: 1;
		letter-spacing: -1.5px;
	}

	.header-content p:last-child {
		max-width: 470px;
		margin: 20px 0 0;
		font-size: 17px;
		line-height: 1.5;
		color: #e5ebe6;
	}

	.program {
		max-width: 680px;
		margin: 0 auto;
		padding: 28px 16px 10px;
	}

	.section-intro {
		padding: 8px 4px 24px;
	}

	.section-label,
	.day-label,
	.closing-label {
		margin: 0 0 8px;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1.5px;
		color: #8b7950;
	}

	.section-intro h2 {
		margin: 0;
		font-size: 27px;
		line-height: 1.15;
	}

	.section-intro > p:last-child {
		margin: 12px 0 0;
		font-size: 15px;
		line-height: 1.55;
		color: #68736b;
	}

	.day {
		display: grid;
		grid-template-columns: 66px 1fr;
		gap: 18px;
		margin-bottom: 16px;
		padding: 20px 18px;
		background: white;
		border-radius: 16px;
		box-shadow: 0 2px 9px rgba(30, 50, 35, 0.08);
	}

	.arrival-day {
		background: #f8f5e9;
		border: 1px solid #e7ddbc;
	}

	.date {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: flex-start;
		width: 60px;
		height: 68px;
		padding-top: 8px;
		border-radius: 12px;
		background: #edf2eb;
	}

	.arrival-date {
		background: #e7ddbc;
	}

	.day-number {
		font-size: 27px;
		font-weight: 700;
		line-height: 1;
		color: #294936;
	}

	.month {
		margin-top: 5px;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 1px;
		color: #718078;
	}

	.day-content h2 {
		margin: 0;
		font-size: 22px;
		line-height: 1.2;
		color: #24352a;
	}

	.session-label {
		display: inline-block;
		margin: 0 0 9px;
		padding: 5px 9px;
		border-radius: 6px;
		background: #edf2eb;
		color: #294936;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.8px;
		text-transform: uppercase;
	}

	.arrival-day .session-label {
		background: #e7ddbc;
		color: #5b5133;
	}

	.location {
		margin: 6px 0 17px;
		font-size: 14px;
		color: #68736b;
	}

	.activity {
		margin-top: 14px;
	}

	.activity strong {
		display: block;
		font-size: 15px;
		color: #294936;
	}

	.activity p {
		margin: 5px 0 0;
		font-size: 14px;
		line-height: 1.5;
		color: #5f6962;
	}

	.visit-divider {
		height: 1px;
		margin: 24px 0;
		background: #e5e8e4;
	}

	.return-session {
		padding-top: 2px;
	}

	.return-session h2 {
		font-size: 21px;
	}

	.closing {
		max-width: 680px;
		margin: 10px auto 0;
		padding: 32px 20px;
		background: #e7ddbc;
		text-align: center;
	}

	.closing-label {
		color: #5b5133;
	}

	.closing h2 {
		max-width: 480px;
		margin: 0 auto 20px;
		font-size: 24px;
		line-height: 1.25;
	}

	.home-button {
		display: inline-block;
		padding: 13px 20px;
		border-radius: 10px;
		background: #294936;
		color: white;
		text-decoration: none;
		font-weight: 700;
	}

	footer {
		max-width: 680px;
		margin: 0 auto;
		padding: 28px 20px 36px;
		text-align: center;
		font-size: 12px;
		line-height: 1.5;
		color: #788078;
	}

	footer p {
		margin: 3px 0;
	}

	@media (min-width: 700px) {
		.page-header {
			padding: 26px 32px 54px;
		}

		.program {
			padding-top: 36px;
		}

		.day {
			padding: 24px;
		}
	}
</style>