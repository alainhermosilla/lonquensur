---
import Layout from '../layouts/Layout.astro';

const apiUrl = import.meta.env.PUBLIC_IA_API_URL?.trim() ?? '';
const enabled = apiUrl.length > 0;
---

<Layout>
	<main>
		<header class="page-header">
			<a href="/" class="back">← Volver al inicio</a>
			<p class="eyebrow">INFORMACIÓN OFICIAL DE LA GIRA</p>
			<h1>Asistente de la Gira</h1>
			<p class="intro">
				Pregunta por el programa, las visitas, las encuestas y las recomendaciones publicadas.
			</p>
		</header>

		<section class="assistant" data-assistant data-enabled={String(enabled)}>
			<div class="notice">
				<span class="notice-icon" aria-hidden="true">i</span>
				<div>
					<strong>Información importante</strong>
					<p>Hola. Puedo ayudarte con la información oficial disponible sobre la Gira AgrocoopInnova 2026.</p>
					<p>Las respuestas se basan solo en información oficial interna. El asistente no navega por Internet y te indicará cuando un dato no esté publicado.</p>
				</div>
			</div>

			{enabled ? (
				<>
					<div class="conversation-tools">
						<button type="button" data-clear disabled aria-label="Borrar todas las preguntas y respuestas visibles">Limpiar conversación</button>
					</div>
					<div class="messages" data-messages aria-live="polite"></div>

					<div class="examples">
						<h2>Ejemplos de preguntas</h2>
						<p>Selecciona una pregunta para copiarla en el recuadro.</p>
						<div class="suggestions" aria-label="Ejemplos de preguntas">
							<button type="button" data-suggestion>¿Qué hacemos el 9 de septiembre?</button>
							<button type="button" data-suggestion>¿Qué debo llevar a las visitas?</button>
							<button type="button" data-suggestion>¿Cuándo abre la encuesta de COOPEUMO?</button>
						</div>
					</div>

					<form class="question-form" data-form method="post">
						<label for="pregunta">Tu pregunta</label>
						<div class="input-row">
							<textarea id="pregunta" name="pregunta" rows="2" maxlength="500" required placeholder="Por ejemplo: ¿Qué hacemos mañana en la mañana?"></textarea>
							<button type="submit" data-submit>Preguntar</button>
						</div>
						<p class="form-note"><strong>Importante:</strong> no incluyas información personal o sensible.</p>
					</form>
				</>
			) : (
				<div class="disabled-state">
					<span aria-hidden="true">✦</span>
					<h2>El asistente está en preparación</h2>
					<p>La base interna ya está organizada. Activaremos las consultas después de conectar y probar el modelo local.</p>
					<a href="/programa/">Mientras tanto, revisa el programa</a>
				</div>
			)}
		</section>

		<footer>
			<p>Gira de innovación AgrocoopInnova 2026</p>
			<p><a class="footer-link" href="https://lonquensur.cl" target="_blank" rel="noopener noreferrer">LonquenSur</a> - IEAC</p>
		</footer>
	</main>
</Layout>

{enabled && (
	<script define:vars={{ apiUrl }}>
		const form = document.querySelector('[data-form]');
		const textarea = document.querySelector('#pregunta');
		const messages = document.querySelector('[data-messages]');
		const submit = document.querySelector('[data-submit]');
		const clear = document.querySelector('[data-clear]');

		function updateClearButton() {
			if (clear) clear.disabled = !messages?.children.length;
		}

		function addMessage(text, type, sources = []) {
			const article = document.createElement('div');
			article.className = `message message--${type}`;

			const paragraph = document.createElement('p');
			paragraph.textContent = text;
			article.append(paragraph);

			if (sources.length) {
				const details = document.createElement('details');
				const summary = document.createElement('summary');
				summary.textContent = 'Ver fuentes internas';
				details.append(summary);

				const list = document.createElement('ul');
				for (const source of sources) {
					const item = document.createElement('li');
					const link = document.createElement('a');
					link.textContent = source.titulo;
					link.href = source.fuente.startsWith('/') ? source.fuente : '#';
					if (link.href.endsWith('#')) link.removeAttribute('href');
					item.append(link);
					list.append(item);
				}
				details.append(list);
				article.append(details);
			}

			messages?.append(article);
			updateClearButton();
			article.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}

		function addProgress() {
			const article = document.createElement('div');
			article.className = 'message message--assistant message--progress';
			article.setAttribute('role', 'status');
			const paragraph = document.createElement('p');
			paragraph.textContent = 'Buscando en la información oficial…';
			article.append(paragraph);
			messages?.append(article);
			const preparing = setTimeout(() => { paragraph.textContent = 'Preparando la respuesta…'; }, 2000);
			const coldStart = setTimeout(() => { paragraph.textContent = 'La primera consulta puede tardar unos segundos más…'; }, 8000);
			return () => {
				clearTimeout(preparing);
				clearTimeout(coldStart);
				article.remove();
			};
		}

		async function ask(question) {
			if (!submit || !textarea) return;
			submit.disabled = true;
			textarea.disabled = true;
			if (clear) clear.disabled = true;
			submit.textContent = 'Consultando…';
			const removeProgress = addProgress();
			const controller = new AbortController();
			const timeout = setTimeout(() => controller.abort(), 35_000);

			try {
				const response = await fetch(`${apiUrl.replace(/\/$/, '')}/v1/consultar`, {
					method: 'POST',
					headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ pregunta: question }),
					signal: controller.signal,
				});
				const payload = await response.json();
				if (!response.ok) throw new Error(payload.error || 'No fue posible consultar el asistente.');
				addMessage(payload.respuesta, 'assistant', payload.fuentes || []);
			} catch (error) {
				const message = error?.name === 'AbortError'
					? 'La consulta tardó demasiado. Intenta nuevamente en unos segundos.'
					: 'El asistente no está disponible temporalmente. Puedes consultar directamente el programa y las visitas.';
				addMessage(message, 'error');
			} finally {
				clearTimeout(timeout);
				removeProgress();
				submit.disabled = false;
				textarea.disabled = false;
				submit.textContent = 'Preguntar';
				updateClearButton();
				textarea.focus();
			}
		}

		form?.addEventListener('submit', (event) => {
			event.preventDefault();
			const question = textarea?.value.trim();
			if (!question) return;
			addMessage(question, 'user');
			textarea.value = '';
			ask(question);
		});

		document.querySelectorAll('[data-suggestion]').forEach((button) => {
			button.addEventListener('click', () => {
				if (!textarea) return;
				textarea.value = button.textContent?.trim() || '';
				textarea.focus();
			});
		});

		clear?.addEventListener('click', () => {
			messages?.replaceChildren();
			if (textarea) textarea.value = '';
			updateClearButton();
			textarea?.focus();
		});
	</script>
)}

<style>
	:global(*) { box-sizing: border-box; }
	:global(body) { margin: 0; background: #eef1ed; color: #19352a; font-family: Arial, Helvetica, sans-serif; }
	main { min-height: 100vh; }
	.page-header { padding: 18px 20px 34px; background: linear-gradient(135deg, #245b45, #173e30); color: white; }
	.page-header > * { max-width: 680px; margin-right: auto; margin-left: auto; }
	.back { display: block; margin-bottom: 24px; color: white; font-size: 14px; font-weight: 700; text-decoration: none; }
	.eyebrow { margin-bottom: 8px; color: #e4c96e; font-size: 11px; font-weight: 800; letter-spacing: 1.5px; }
	h1 { margin-top: 0; margin-bottom: 10px; font-size: clamp(38px, 8vw, 58px); line-height: 1; }
	.intro { margin-top: 0; margin-bottom: 0; font-size: 18px; line-height: 1.55; opacity: .95; }
	.assistant { max-width: 720px; min-height: 520px; margin: -16px auto 0; padding: 16px; }
	.notice { display: grid; grid-template-columns: 34px 1fr; gap: 12px; padding: 17px 18px; border: 2px solid #b9d2bf; border-radius: 14px; background: #f5faf6; color: #244c39; font-size: 16px; line-height: 1.55; }
	.notice-icon { display: grid; width: 30px; height: 30px; place-items: center; border-radius: 50%; background: #245b45; color: white; font-size: 17px; font-weight: 800; }
	.notice strong { display: block; margin-bottom: 3px; font-size: 18px; }
	.notice p { margin: 0; color: #4f675b; }
	.notice p + p { margin-top: 7px; }
	.conversation-tools { display: flex; justify-content: flex-end; padding-top: 14px; }
	.conversation-tools button { padding: 10px 14px; border: 1px solid #913a2c; border-radius: 9px; background: #a84935; color: white; cursor: pointer; font-size: 15px; font-weight: 800; }
	.conversation-tools button:hover:not(:disabled), .conversation-tools button:focus-visible:not(:disabled) { border-color: #6f2b21; background: #8e382b; outline: 3px solid rgba(168,73,53,.18); }
	.conversation-tools button:disabled { border-color: #b8bdb9; background: #d8dcda; color: #6f7671; cursor: default; opacity: 1; }
	.messages { display: flex; flex-direction: column; gap: 12px; min-height: 90px; padding: 18px 0; }
	.messages:empty { min-height: 22px; padding: 11px 0; }
	.message { max-width: 88%; padding: 16px 18px; border-radius: 16px; background: white; box-shadow: 0 2px 9px rgba(25,53,42,.08); font-size: 17px; line-height: 1.62; }
	.message p { margin: 0; white-space: pre-wrap; }
	.message--user { align-self: flex-end; background: #245b45; color: white; border-bottom-right-radius: 5px; }
	.message--assistant { align-self: flex-start; border-bottom-left-radius: 5px; }
	.message--error { align-self: flex-start; border: 1px solid #e6c8c1; background: #fff7f5; color: #773c31; }
	.message--progress { color: #637068; font-style: italic; }
	details { margin-top: 12px; border-top: 1px solid #e5e9e5; padding-top: 10px; font-size: 14px; }
	summary { cursor: pointer; font-weight: 700; }
	details ul { margin: 8px 0 0; padding-left: 20px; }
	details a { color: #245b45; }
	.examples { margin-bottom: 16px; padding: 16px; border: 1px solid #cbd9ce; border-radius: 16px; background: #f8faf8; }
	.examples h2 { margin: 0 0 4px; color: #244c39; font-size: 20px; }
	.examples > p { margin: 0 0 12px; color: #637068; font-size: 15px; line-height: 1.5; }
	.suggestions { display: flex; flex-wrap: wrap; gap: 9px; }
	.suggestions button { padding: 11px 14px; border: 1px solid #adc5b3; border-radius: 10px; background: white; color: #244c39; cursor: pointer; font-size: 15px; line-height: 1.4; text-align: left; }
	.suggestions button:hover, .suggestions button:focus-visible { border-color: #245b45; background: #eef6f0; outline: none; }
	.question-form { padding: 15px; border-radius: 16px; background: white; box-shadow: 0 3px 14px rgba(25,53,42,.1); }
	.question-form label { display: block; margin-bottom: 8px; font-size: 17px; font-weight: 800; }
	.input-row { display: flex; align-items: stretch; gap: 9px; }
	textarea { min-height: 78px; flex: 1; resize: vertical; padding: 14px 15px; border: 2px solid #aebfb2; border-radius: 10px; font: inherit; font-size: 18px; line-height: 1.5; }
	textarea:focus { border-color: #245b45; outline: 3px solid rgba(36,91,69,.14); }
	.input-row button { min-width: 116px; border: 0; border-radius: 10px; background: #245b45; color: white; cursor: pointer; font-size: 17px; font-weight: 800; }
	.input-row button:disabled { cursor: wait; opacity: .65; }
	.form-note { margin: 12px 0 0; padding: 11px 13px; border-left: 4px solid #c79a43; border-radius: 6px; background: #fff8e8; color: #664f20; font-size: 15px; line-height: 1.5; }
	.disabled-state { margin-top: 22px; padding: 54px 24px; border-radius: 20px; background: white; box-shadow: 0 4px 18px rgba(25,53,42,.09); text-align: center; }
	.disabled-state > span { display: block; color: #c79a43; font-size: 42px; }
	.disabled-state h2 { margin: 10px 0; font-size: 26px; }
	.disabled-state p { max-width: 480px; margin: 0 auto 20px; color: #637068; line-height: 1.55; }
	.disabled-state a { display: inline-block; padding: 11px 15px; border-radius: 10px; background: #245b45; color: white; font-weight: 700; text-decoration: none; }
	footer { padding: 26px 20px 36px; color: #788078; text-align: center; font-size: 12px; line-height: 1.5; }
	footer p { margin: 2px 0; }
	@media (max-width: 540px) {
		.assistant { padding: 10px; }
		.message { max-width: 96%; font-size: 17px; }
		.notice { grid-template-columns: 30px 1fr; padding: 15px; }
		.examples { padding: 14px; }
		.suggestions { display: grid; }
		.input-row { display: grid; }
		.input-row button { min-height: 50px; font-size: 16px; }
	}
</style>
