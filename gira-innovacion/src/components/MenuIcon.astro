---
type IconName = 'notices' | 'calendar' | 'location' | 'document' | 'survey' | 'notebook';

interface Props {
	name: IconName;
}

const { name } = Astro.props;
---

<svg
	viewBox="0 0 32 32"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
>
	{name === 'notices' && (
		<>
			<path d="M5 14v4l4 1 12 6V7L9 13l-4 1Z" />
			<path d="M9 19l2 7h5l-3-5" />
			<path d="M25 11c1.3 1.2 2 2.9 2 5s-.7 3.8-2 5" />
		</>
	)}
	{name === 'calendar' && (
		<>
			<rect x="5" y="7" width="22" height="20" rx="3" />
			<path d="M10 4v6M22 4v6M5 13h22" />
			<path d="M10 18h2M16 18h2M22 18h2M10 23h2M16 23h2" />
		</>
	)}
	{name === 'location' && (
		<>
			<path d="M16 28s9-8.1 9-16a9 9 0 1 0-18 0c0 7.9 9 16 9 16Z" />
			<circle cx="16" cy="12" r="3.5" />
		</>
	)}
	{name === 'document' && (
		<>
			<path d="M8 4h11l6 6v18H8Z" />
			<path d="M19 4v7h6M12 17h9M12 22h7" />
		</>
	)}
	{name === 'survey' && (
		<>
			<rect x="7" y="6" width="18" height="22" rx="2" />
			<path d="M12 6V4h8v2M11 18l3 3 7-8" />
		</>
	)}
	{name === 'notebook' && (
		<>
			<rect x="8" y="5" width="18" height="22" rx="2" />
			<path d="M8 9H5M8 14H5M8 19H5M8 24H5M14 12h7M14 17h7" />
			<circle cx="6" cy="9" r="1.5" />
			<circle cx="6" cy="14" r="1.5" />
			<circle cx="6" cy="19" r="1.5" />
			<circle cx="6" cy="24" r="1.5" />
		</>
	)}
</svg>

<style>
	svg {
		display: block;
		width: 29px;
		height: 29px;
	}
</style>
